<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VRCoplay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VRCoplay">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>
    <Page x:Name="RootPage" Background="Transparent">
        <Grid RowDefinitions="Auto,*">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup><VisualState>
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Layout.ColumnSpacing" Value="24" /><Setter Target="ControlsColumn.Width" Value="400" />
                        <Setter Target="ControlsPane.(Grid.Row)" Value="0" /><Setter Target="ControlsPane.(Grid.Column)" Value="1" />
                        <Setter Target="PreviewHost.Height" Value="360" />
                    </VisualState.Setters>
                </VisualState></VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TitleBar x:Name="AppTitleBar" Title="VRCoplay" Subtitle="Local, low-latency streaming" />
            <Grid Grid.Row="1" MaxWidth="1180">
                <ScrollView x:Name="Scroller">
                    <Grid x:Name="Layout" Padding="24" RowSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition x:Name="ControlsColumn" Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Live preview" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Border x:Name="PreviewHost" Height="260" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                                <TextBlock x:Name="PreviewEmpty" Text="Select an application to preview it" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="ControlsPane" Grid.Row="1" Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox x:Name="WindowPicker" Header="Application" HorizontalAlignment="Stretch" DisplayMemberPath="Label" DropDownOpened="WindowPicker_DropDownOpened" SelectionChanged="WindowPicker_SelectionChanged" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="Refresh_Click" ToolTipService.ToolTip="Refresh"><SymbolIcon Symbol="Refresh" /></Button>
                            </Grid>
                            <Expander Header="Advanced settings" HorizontalAlignment="Stretch">
                                <StackPanel Padding="0,8,0,4" Spacing="10">
                                    <ToggleSwitch x:Name="AudioToggle" Header="Include application audio" IsOn="True" />
                                    <ToggleSwitch x:Name="LowLatencyToggle" Header="VRChat world uses Low Latency Stream" IsOn="True" />
                                </StackPanel>
                            </Expander>
                            <TextBox Header="VRChat stream URL" Text="rtsp://127.0.0.1:8554/game" IsReadOnly="True" />
                            <Button x:Name="StartButton" Content="Start streaming" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
                            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Message="Ready." />
                        </StackPanel>
                    </Grid>
                </ScrollView>
            </Grid>
        </Grid>
    </Page>
</Window>
