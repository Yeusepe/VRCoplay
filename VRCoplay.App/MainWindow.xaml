<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VRCoplay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls" Title="VRCoplay">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt" /></Window.SystemBackdrop>
    <Page x:Name="RootPage" Background="Transparent">
        <Grid RowDefinitions="Auto,*">
            <TitleBar x:Name="AppTitleBar" Title="VRCoplay" Subtitle="Local, low-latency streaming" />
            <ScrollView x:Name="Scroller" Grid.Row="1">
                <StackPanel Padding="24,0" Spacing="24">
                    <Grid x:Name="Hero">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="14">
                            <TextBlock Text="Live preview" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Border x:Name="PreviewHost" Height="360" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                                <TextBlock x:Name="PreviewEmpty" Text="Select an application to preview it" Opacity="0.65" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ComboBox x:Name="WindowPicker" Header="Application" HorizontalAlignment="Stretch" DisplayMemberPath="Label" DropDownOpened="WindowPicker_DropDownOpened" SelectionChanged="WindowPicker_SelectionChanged" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="Refresh_Click" ToolTipService.ToolTip="Refresh applications"><SymbolIcon Symbol="Refresh" /></Button>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Header="VRChat stream URL" Text="rtsp://127.0.0.1:8554/game" IsReadOnly="True" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="CopyUrl_Click" ToolTipService.ToolTip="Copy stream URL"><SymbolIcon Symbol="Copy" /></Button>
                            </Grid>
                            <Button x:Name="StartButton" Content="Start streaming" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" />
                            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Message="Ready." />
                        </StackPanel>
                    </Grid>

                    <Border MaxWidth="900" HorizontalAlignment="Stretch" Padding="24" CornerRadius="16,16,0,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ContentControl x:Name="SettingsSheet" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="Tune the stream, or leave everything automatic." Opacity="0.65" /></StackPanel>
                                <Button Grid.Column="1" Content="Reset to automatic" Click="Reset_Click" />
                            </Grid>

                            <toolkit:SettingsExpander Header="General" Description="Audio, controllers, and the VRChat world player" IsExpanded="True">
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard Header="Application audio" Description="Capture only the selected process tree." ToolTipService.ToolTip="Silence is continuously supplied so audio never delays video startup."><ToggleSwitch x:Name="AudioToggle" IsOn="True" /></toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="SteamVR controller bridge" Description="Expose both VR controllers as one local gamepad." ToolTipService.ToolTip="Turn this off to stream without SteamVR or usbip-win2."><ToggleSwitch x:Name="ControllerToggle" IsOn="True" /></toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="World playback" Description="Automatic keeps the proven zero-copy path." ToolTipService.ToolTip="Buffered burns a warning into the video and adds GPU readback latency.">
                                        <ComboBox x:Name="WorldMode" SelectedIndex="0"><x:String>Automatic</x:String><x:String>Low latency</x:String><x:String>Buffered</x:String></ComboBox>
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>

                            <toolkit:SettingsExpander Header="Capture" Description="Window capture size and rate">
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard Header="Capture cursor" Description="Include the pointer in the stream."><ToggleSwitch x:Name="CursorToggle" IsOn="True" /></toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="Frame-rate cap" Description="Blank uses the automatic 60 FPS cap." ToolTipService.ToolTip="1–240 FPS. Keyframe spacing follows this value."><NumberBox x:Name="FpsBox" Width="120" Minimum="1" Maximum="240" SpinButtonPlacementMode="Compact" /></toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="Output size" Description="Leave both blank for the application's native size." ToolTipService.ToolTip="Both values must be positive even numbers; scaling preserves aspect ratio.">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><NumberBox x:Name="WidthBox" Header="Width" Width="120" Minimum="2" SpinButtonPlacementMode="Compact" /><NumberBox x:Name="HeightBox" Header="Height" Width="120" Minimum="2" SpinButtonPlacementMode="Compact" /></StackPanel>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="Crop" Description="Pixels removed before resizing." ToolTipService.ToolTip="Crop values must be whole, nonnegative numbers smaller than the source image.">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><NumberBox x:Name="CropLeftBox" Header="Left" Width="90" Minimum="0" Value="0" /><NumberBox x:Name="CropTopBox" Header="Top" Width="90" Minimum="0" Value="0" /><NumberBox x:Name="CropRightBox" Header="Right" Width="90" Minimum="0" Value="0" /><NumberBox x:Name="CropBottomBox" Header="Bottom" Width="90" Minimum="0" Value="0" /></StackPanel>
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>

                            <toolkit:SettingsExpander Header="Encoding and expert" Description="Hardware selection, quality, and FFmpeg overrides">
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard Header="Encoder" Description="Automatic probes NVIDIA, AMD, Intel, then x264." ToolTipService.ToolTip="A manual choice fails clearly instead of falling back.">
                                        <ComboBox x:Name="EncoderPicker" SelectedIndex="0" SelectionChanged="EncoderPicker_SelectionChanged"><x:String>Automatic</x:String><x:String>NVIDIA NVENC</x:String><x:String>AMD AMF</x:String><x:String>Intel Quick Sync</x:String><x:String>x264 software</x:String></ComboBox>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="Quality / QP" Description="Blank uses the proven encoder default." ToolTipService.ToolTip="0–51; lower values use more bandwidth and produce higher quality."><NumberBox x:Name="QualityBox" Width="120" Minimum="0" Maximum="51" SpinButtonPlacementMode="Compact" /></toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="Extra FFmpeg arguments" Description="Advanced overrides; these can prevent playback." ContentAlignment="Vertical" ToolTipService.ToolTip="Arguments are parsed with Windows quoting rules and never passed through a shell.">
                                        <TextBox x:Name="ExtraArgs" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" PlaceholderText="Leave empty for automatic" />
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>
                        </StackPanel></ContentControl>
                    </Border>
                </StackPanel>
            </ScrollView>
        </Grid>
    </Page>
</Window>
