<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="VRCoplay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VRCoplay">
    <StackPanel Padding="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Stretch">
        <TextBlock Text="Stream an application to VRChat" Style="{StaticResource TitleTextBlockStyle}" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ComboBox x:Name="WindowPicker" Header="Application" DisplayMemberPath="Label" HorizontalAlignment="Stretch" DropDownOpened="WindowPicker_DropDownOpened" />
            <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" VerticalAlignment="Bottom" Click="Refresh_Click" />
        </Grid>
        <ToggleSwitch x:Name="AudioToggle" Header="Include application audio" IsOn="True" />
        <ToggleSwitch x:Name="LowLatencyToggle" Header="VRChat world uses Low Latency Stream" IsOn="True" />
        <TextBox Header="VRChat stream URL" Text="rtsp://127.0.0.1:8554/game" IsReadOnly="True" />
        <Button x:Name="StartButton" Content="Start streaming" HorizontalAlignment="Left" Click="Start_Click" />
        <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Message="Ready." />
    </StackPanel>
</Window>
